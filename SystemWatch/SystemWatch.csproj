<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SystemWatch</RootNamespace>
    <AssemblyName>SystemWatch</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>

    <Product>SystemWatch</Product>
    <AssemblyTitle>SystemWatch</AssemblyTitle>
    <Description>Übersichtlicher Taskmanager-Ersatz</Description>
    <Copyright>Copyright © 2025</Copyright>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Icon.ico" />
  </ItemGroup>

</Project>
