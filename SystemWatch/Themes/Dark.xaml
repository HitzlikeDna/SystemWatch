<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Farbsystem „Dunkel“ (Standard). Flächen sind neutral-warmes Grau, Text in drei Abstufungen.
        Jede Kennzahl hat eine feste Erkennungsfarbe, die überall gleich bleibt
        (Kachel, Graph, Seitenleiste, Tabelle). Die Akzentfarben stammen aus einer auf
        Farbsehschwäche geprüften Palette und erreichen ≥ 3:1 Kontrast zur Kartenfläche.

        Light.xaml enthält dieselben Schlüssel. Verwendet werden sie ausschließlich per
        DynamicResource, damit das Design zur Laufzeit umgeschaltet werden kann.
    -->

    <!-- Flächen -->
    <Color x:Key="PageColor">#FF101010</Color>
    <Color x:Key="SurfaceColor">#FF1A1A19</Color>
    <Color x:Key="ElevatedColor">#FF242423</Color>
    <Color x:Key="ControlColor">#FF262624</Color>
    <Color x:Key="ControlHoverColor">#FF302F2D</Color>
    <Color x:Key="ControlPressedColor">#FF222221</Color>
    <Color x:Key="BorderColor">#14FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#29FFFFFF</Color>
    <Color x:Key="WindowBorderColor">#FF2C2C2A</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF0EFEC</Color>
    <Color x:Key="TextSecondaryColor">#FFC3C2B7</Color>
    <Color x:Key="TextMutedColor">#FF898781</Color>

    <!-- Interaktion -->
    <Color x:Key="AccentColor">#FF3987E5</Color>
    <Color x:Key="AccentHoverColor">#FF4B94EA</Color>
    <Color x:Key="DangerColor">#FFD03B3B</Color>
    <Color x:Key="DangerHoverColor">#FFDC4E4E</Color>
    <Color x:Key="WarningColor">#FFFAB219</Color>

    <!-- Kennzahlen -->
    <Color x:Key="CpuColor">#FF3987E5</Color>
    <Color x:Key="MemoryColor">#FF9085E9</Color>
    <Color x:Key="GpuColor">#FF199E70</Color>
    <Color x:Key="NetworkColor">#FFD95926</Color>
    <Color x:Key="DiskColor">#FFD55181</Color>

    <!-- Graphen -->
    <Color x:Key="ChartGridColor">#FF2C2C2A</Color>
    <Color x:Key="ChartBaselineColor">#FF383835</Color>
    <Color x:Key="ChartTooltipColor">#FF262624</Color>
    <Color x:Key="ChartTooltipBorderColor">#FF3A3A37</Color>

    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#333987E5" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#80FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263987E5" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#803987E5" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}" />
    <SolidColorBrush x:Key="MemoryBrush" Color="{StaticResource MemoryColor}" />
    <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}" />
    <SolidColorBrush x:Key="NetworkBrush" Color="{StaticResource NetworkColor}" />
    <SolidColorBrush x:Key="DiskBrush" Color="{StaticResource DiskColor}" />

    <!-- Leere Spur eines Balkens: derselbe Farbton, nur heller/transparenter -->
    <SolidColorBrush x:Key="CpuTrackBrush" Color="{StaticResource CpuColor}" Opacity="0.2" />
    <SolidColorBrush x:Key="MemoryTrackBrush" Color="{StaticResource MemoryColor}" Opacity="0.2" />
    <SolidColorBrush x:Key="GpuTrackBrush" Color="{StaticResource GpuColor}" Opacity="0.2" />
    <SolidColorBrush x:Key="DiskTrackBrush" Color="{StaticResource DiskColor}" Opacity="0.2" />

</ResourceDictionary>
