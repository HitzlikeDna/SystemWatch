<UserControl x:Class="SystemWatch.Views.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charts="clr-namespace:SystemWatch.Charts"
             xmlns:vm="clr-namespace:SystemWatch.ViewModels"
             xmlns:views="clr-namespace:SystemWatch.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MetricViewModel}"
             d:DesignWidth="380" d:DesignHeight="320"
             x:Name="Root">

    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="70" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Margin="0,1,9,0" VerticalAlignment="Center"
                         Fill="{Binding AccentBrush, ElementName=Root}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                           Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           ToolTip="{Binding Detail}" />
            </Grid>

            <!-- Hauptwert (eine Reihe) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6"
                        Visibility="{Binding SecondarySeries, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding Value}" Style="{StaticResource HeroValue}" />
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="12,0,0,8" VerticalAlignment="Bottom" />
            </StackPanel>

            <!-- Hauptwerte (zwei Reihen, mit Legende) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6"
                        Visibility="{Binding SecondarySeries, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MinWidth="120">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding AccentBrush, ElementName=Root}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PrimaryLabel, ElementName=Root}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource HeroValueSmall}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Margin="24,0,0,0" MinWidth="120">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="2" CornerRadius="1" Background="{Binding SecondaryAccentBrush, ElementName=Root}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SecondaryLabel, ElementName=Root}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SecondaryValue}" Style="{StaticResource HeroValueSmall}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Verlauf -->
            <charts:LiveGraph Grid.Row="2" Margin="0,4,0,0"
                              Series="{Binding Series}"
                              SecondarySeries="{Binding SecondarySeries}"
                              Color="{Binding Accent, ElementName=Root}"
                              Unit="{Binding Unit, ElementName=Root}"
                              Maximum="{Binding Maximum, ElementName=Root}"
                              MinimumScale="{Binding MinimumScale, ElementName=Root}"
                              PrimaryLabel="{Binding PrimaryLabel, ElementName=Root}"
                              SecondaryLabel="{Binding SecondaryLabel, ElementName=Root}" />

            <!-- Zusatzinhalt (z. B. Laufwerke) -->
            <ContentPresenter Grid.Row="3" Content="{Binding ExtraContent, ElementName=Root}" />

            <!-- Kennzahlen -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding Stats}" Margin="0,14,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:StatsPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatItem}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
