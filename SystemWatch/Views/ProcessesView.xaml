<UserControl x:Class="SystemWatch.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SystemWatch.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProcessListViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Margin="6,0,6,16">
            <TextBlock Text="Prozesse" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Werkzeugleiste -->
        <Grid Grid.Row="1" Margin="6,0,6,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Name oder PID suchen  (Strg+F)"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox Style="{StaticResource ChipToggle}" Content="Gleichnamige zusammenfassen"
                          IsChecked="{Binding GroupByName}"
                          ToolTip="Fasst z. B. alle Chrome-Prozesse in einer Zeile zusammen" />
                <CheckBox Style="{StaticResource ChipToggle}" Content="Windows-Prozesse" Margin="8,0,0,0"
                          IsChecked="{Binding ShowWindowsProcesses}"
                          ToolTip="Systemdienste und Komponenten von Windows anzeigen" />
                <Button Style="{StaticResource DangerButton}" Margin="12,0,0,0" Command="{Binding KillCommand}"
                        AutomationProperties.Name="Task beenden"
                        ToolTip="Ausgewählten Prozess beenden (Entf)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Task beenden" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabelle -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="6,0,6,6" Padding="8,4,6,8">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource ProcessGrid}"
                          ItemsSource="{Binding View}"
                          SelectedItem="{Binding SelectedRow}"
                          Sorting="Grid_Sorting">

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding KillCommand}" />
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Task beenden" Command="{Binding KillCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Dateispeicherort öffnen" Command="{Binding OpenLocationCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <TextBlock Margin="14,16,0,6" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                                    </TextBlock>
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="NameColumn" Header="Name" Width="*" MinWidth="220" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ImagePath}" ToolTipService.InitialShowDelay="900">
                                        <Grid Width="18" Height="18" Margin="0,0,12,0">
                                            <Border CornerRadius="4" Background="{StaticResource ControlHoverBrush}"
                                                    Visibility="{Binding Icon, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="7,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="PidColumn" Header="PID" Width="84" MinWidth="84" Binding="{Binding Pid}" SortMemberPath="Pid"
                                            HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumberText}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CPU" Width="96" MinWidth="96" Binding="{Binding CpuText}" SortMemberPath="Cpu"
                                            HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumberText}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                    <Setter Property="Background" Value="{Binding CpuHeat, Converter={StaticResource HeatBrush}, ConverterParameter=#3987E5}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Arbeitsspeicher" Width="150" MinWidth="150" Binding="{Binding MemoryText}" SortMemberPath="MemoryBytes"
                                            HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumberText}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                    <Setter Property="Background" Value="{Binding MemoryHeat, Converter={StaticResource HeatBrush}, ConverterParameter=#9085E9}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="GPU" Width="96" MinWidth="96" Binding="{Binding GpuText}" SortMemberPath="GpuSort"
                                            HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumberText}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                    <Setter Property="Background" Value="{Binding GpuHeat, Converter={StaticResource HeatBrush}, ConverterParameter=#199E70}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Keine passenden Prozesse gefunden" Style="{StaticResource Caption}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
