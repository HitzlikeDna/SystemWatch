<UserControl x:Class="SystemWatch.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charts="clr-namespace:SystemWatch.Charts"
             xmlns:views="clr-namespace:SystemWatch.Views"
             xmlns:vm="clr-namespace:SystemWatch.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Margin="6,0,6,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Übersicht" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding HistoryText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <UniformGrid x:Name="CardGrid" Columns="3" VerticalAlignment="Top">

                <views:MetricCard DataContext="{Binding Cpu}" Margin="6" Accent="{StaticResource CpuColor}" Maximum="100" />

                <views:MetricCard DataContext="{Binding Memory}" Margin="6" Accent="{StaticResource MemoryColor}" Maximum="100" />

                <views:MetricCard DataContext="{Binding Gpu}" Margin="6" Accent="{StaticResource GpuColor}" Maximum="100" />

                <views:MetricCard DataContext="{Binding Network}" Margin="6" Accent="{StaticResource NetworkColor}"
                                  Unit="BytesPerSecond" MinimumScale="102400"
                                  PrimaryLabel="Empfangen" SecondaryLabel="Gesendet" />

                <views:MetricCard DataContext="{Binding Disk}" Margin="6" Accent="{StaticResource DiskColor}"
                                  Unit="BytesPerSecond" MinimumScale="1048576"
                                  PrimaryLabel="Lesen" SecondaryLabel="Schreiben">
                    <views:MetricCard.ExtraContent>
                        <!-- Belegung der Laufwerke: kompakt in zwei Spalten, Details im Tooltip -->
                        <ItemsControl Margin="0,12,0,0" Focusable="False"
                                      ItemsSource="{Binding DataContext.Drives, RelativeSource={RelativeSource AncestorType=views:OverviewView}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                    <Grid Margin="0,3,14,3" Background="Transparent">
                                        <Grid.ToolTip>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Free}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource StatValue}" Margin="0" VerticalAlignment="Center" />
                                        <charts:UsageBar Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,0"
                                                         Fraction="{Binding Fraction}"
                                                         Fill="{StaticResource DiskBrush}" Track="{StaticResource DiskTrackBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Usage}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </views:MetricCard.ExtraContent>
                </views:MetricCard>

                <!-- Top-Prozesse -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Margin="0,1,9,0" VerticalAlignment="Center" Fill="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Top-Prozesse" Style="{StaticResource CardTitle}" />
                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Alle Prozesse"
                                    Command="{Binding NavigateCommand}" CommandParameter="Processes" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="Nach CPU-Auslastung, gleichnamige zusammengefasst"
                                   Style="{StaticResource Caption}" Margin="17,2,0,12" />

                        <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TopProcessViewModel}">
                                    <Grid Margin="0,4,0,6" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Width="18" Height="18" HorizontalAlignment="Left">
                                            <Border CornerRadius="4" Background="{StaticResource ControlHoverBrush}"
                                                    Visibility="{Binding Icon, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Cpu}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Memory}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                                        <charts:UsageBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="3" Margin="0,5,0,0"
                                                         Fraction="{Binding Fraction}"
                                                         Fill="{StaticResource CpuBrush}" Track="{StaticResource CpuTrackBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <!-- Erste Messung läuft noch -->
        <TextBlock Grid.Row="1" Text="Messung wird gestartet …" Style="{StaticResource Caption}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsWaitingForData, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
