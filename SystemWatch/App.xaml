<Application x:Class="SystemWatch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SystemWatch.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Muss an erster Stelle stehen: ThemeManager tauscht es gegen Light.xaml aus. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:EqualsConverter x:Key="EqualsConverter" />
            <infra:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <infra:HeatBrushConverter x:Key="HeatBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
