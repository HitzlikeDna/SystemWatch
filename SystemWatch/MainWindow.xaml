<Window x:Class="SystemWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:charts="clr-namespace:SystemWatch.Charts"
        xmlns:views="clr-namespace:SystemWatch.Views"
        xmlns:vm="clr-namespace:SystemWatch.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SystemWatch"
        Icon="Icon.ico"
        Width="1280" Height="840"
        MinWidth="820" MinHeight="560"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        Topmost="{Binding Settings.AlwaysOnTop}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═════════ Seitenleiste ═════════ -->
        <DockPanel Margin="12,14,6,18">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,24">
                <Image Source="Icon.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SystemWatch" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Live-Werte, auf jeder Seite sichtbar -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,8,0">
                <StackPanel.Resources>
                    <Style x:Key="MeterLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                </StackPanel.Resources>

                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU" Style="{StaticResource MeterLabel}" />
                    <TextBlock Text="{Binding Cpu.Value}" Style="{StaticResource MeterLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    <charts:UsageBar Grid.Row="1" Margin="0,5,0,0" Fraction="{Binding Cpu.Fraction}"
                                     Fill="{StaticResource CpuBrush}" Track="{StaticResource CpuTrackBrush}" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Arbeitsspeicher" Style="{StaticResource MeterLabel}" />
                    <TextBlock Text="{Binding Memory.Value}" Style="{StaticResource MeterLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    <charts:UsageBar Grid.Row="1" Margin="0,5,0,0" Fraction="{Binding Memory.Fraction}"
                                     Fill="{StaticResource MemoryBrush}" Track="{StaticResource MemoryTrackBrush}" />
                </Grid>

                <Grid Visibility="{Binding Gpu.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GPU" Style="{StaticResource MeterLabel}" />
                    <TextBlock Text="{Binding Gpu.Value}" Style="{StaticResource MeterLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    <charts:UsageBar Grid.Row="1" Margin="0,5,0,0" Fraction="{Binding Gpu.Fraction}"
                                     Fill="{StaticResource GpuBrush}" Track="{StaticResource GpuTrackBrush}" />
                </Grid>
            </StackPanel>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Content="Übersicht" Tag="&#xE9D9;"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Overview}" />
                <RadioButton Style="{StaticResource NavItem}" Content="Prozesse" Tag="&#xE8FD;"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Processes}" />
                <RadioButton Style="{StaticResource NavItem}" Content="Einstellungen" Tag="&#xE713;"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings}" />
            </StackPanel>
        </DockPanel>

        <!-- ═════════ Inhalt ═════════ -->
        <Grid Grid.Column="1" Margin="10,18,18,14">
            <views:OverviewView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Overview}" />
            <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Processes}">
                <views:ProcessesView x:Name="ProcessesPage" DataContext="{Binding Processes}" />
            </Grid>
            <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Settings}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Grid>
        </Grid>

        <!-- ═════════ Rückfrage ═════════ -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="Collapsed"
              MouseLeftButtonDown="DialogLayer_MouseLeftButtonDown">
            <Border Style="{StaticResource Card}" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                    Width="440" Padding="24,22,24,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="DialogCard_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogMessage" Margin="0,10,0,24" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancel" Content="Abbrechen" MinWidth="96" Click="DialogCancel_Click" />
                        <Button x:Name="DialogConfirm" Style="{StaticResource DangerButton}" MinWidth="96" Margin="8,0,0,0" Click="DialogConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════ Hinweis ═════════ -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                MaxWidth="600" Padding="16,11" CornerRadius="10" BorderThickness="1"
                Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="15" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,11,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ToastText" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
