<Window x:Class="SystemWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="SystemWatch Pro"
        Width="1050"
        Height="850"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF0F2F5" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FF000000" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <TabControl Background="Transparent" BorderThickness="0" Margin="5">
            <TabItem Header="Dashboard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="5" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="SystemWatch" FontSize="18" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Rate:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="UpdateRateCombo" Width="80" SelectionChanged="UpdateRateCombo_SelectionChanged">
                                <ComboBoxItem Tag="500">0,5s</ComboBoxItem>
                                <ComboBoxItem Tag="1000" IsSelected="True">1s</ComboBoxItem>
                                <ComboBoxItem Tag="2000">2s</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text=" History:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <ComboBox x:Name="HistoryCombo" Width="80" SelectionChanged="HistoryCombo_SelectionChanged">
                                <ComboBoxItem Tag="30">kurz</ComboBoxItem>
                                <ComboBoxItem Tag="60" IsSelected="True">mittel</ComboBoxItem>
                            </ComboBox>
                            <CheckBox x:Name="AutostartCheck" Content="Autostart" Margin="15,0,0,0" VerticalAlignment="Center" Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed"/>
                            <ComboBox x:Name="ThemeCombo" Width="80" Margin="15,0,0,0" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Tag="Light" IsSelected="True">Hell</ComboBoxItem>
                                <ComboBoxItem Tag="Dark">Dunkel</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Margin="2" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="CPU" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CpuText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="2" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="RAM" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RamText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="2" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="GPU" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="GpuText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="2" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="5,0">
                                    <TextBlock Text="Netz:" FontSize="10"/>
                                    <TextBlock x:Name="NetText" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <ComboBox x:Name="AdapterCombo" FontSize="10" SelectionChanged="AdapterCombo_SelectionChanged" VerticalAlignment="Center"/>
                                <StackPanel Margin="5,0">
                                    <TextBlock Text="Disk:" FontSize="10"/>
                                    <TextBlock x:Name="DiskText" FontWeight="Bold" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ComboBox x:Name="DriveCombo" FontSize="10" SelectionChanged="DriveCombo_SelectionChanged" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="2" Rows="5" Margin="5">
                        <Border Margin="2" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                <lvc:CartesianChart x:Name="CpuChart" Hoverable="False" DataTooltip="{x:Null}"/>
                            </Grid>
                        </Border>
                        <Border Margin="2" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                <lvc:CartesianChart x:Name="RamChart" Hoverable="False" DataTooltip="{x:Null}"/>
                            </Grid>
                        </Border>
                        <Border Margin="2" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                <lvc:CartesianChart x:Name="GpuChart" Hoverable="False" DataTooltip="{x:Null}"/>
                            </Grid>
                        </Border>
                        <Border Margin="2" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="NET" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                <lvc:CartesianChart x:Name="NetChart" Hoverable="False" DataTooltip="{x:Null}"/>
                            </Grid>
                        </Border>
                        <Border Margin="2" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5">
                            <Grid>
                                <TextBlock Text="DISK" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                <lvc:CartesianChart x:Name="DiskChart" Hoverable="False" DataTooltip="{x:Null}"/>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Prozesse">
                <Border Margin="5" Padding="5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                    <ListView x:Name="ProcessListView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding MemoryMb, StringFormat={}{0:N0} MB}" Width="100"/>
                                <GridViewColumn Header="Aktion" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Beenden" Background="#FFFF4444" Foreground="White" Padding="5,2" Click="KillProcess_Click" Tag="{Binding Id}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>